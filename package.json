{
  "name": "front-end",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/remove-development-assets.mjs",
    "build:check": "node scripts/check-production-build.mjs",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:update": "pnpm api:sync && pnpm api:lint && pnpm api:generate",
    "api:lint": "redocly lint core-console@v0",
    "api:generate": "orval --config orval.config.ts --fail-on-warnings",
    "api:check-generated": "node scripts/check-api-generated.mjs",
    "api:check": "pnpm api:lint && pnpm api:check-generated",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm api:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build && pnpm build:check",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "5.104.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "orval": "8.38.0",
    "oxlint": "^1.86.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
